rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function getAccount(accountId) {
      return get(/databases/$(database)/documents/sharedAccounts/$(accountId)).data;
    }

    function isMemberOfAccount(accountId) {
      return isSignedIn() && (request.auth.uid in getAccount(accountId).memberUids);
    }

    // User profiles
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create, update: if isOwner(userId);
      allow delete: if false;
    }

    // Invite Codes registry (direct 1:1 lookup)
    match /inviteCodes/{code} {
      allow get: if isSignedIn() && isValidId(code);
      allow list: if false;
      allow create: if isSignedIn() && isValidId(code) && request.resource.data.creatorUid == request.auth.uid;
      allow update: if isSignedIn() && resource.data.creatorUid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.creatorUid == request.auth.uid;
    }

    // Shared Accounts
    match /sharedAccounts/{accountId} {
      allow get: if isSignedIn() && (
        (request.auth.uid in resource.data.memberUids) ||
        (request.auth.token.email != null && (request.auth.token.email in resource.data.memberEmails)) ||
        (resource.data.memberUids.size() < 2)
      );

      allow list: if isSignedIn() && (
        resource.data.memberUids.hasAny([request.auth.uid]) ||
        (request.auth.token.email != null && resource.data.memberEmails.hasAny([request.auth.token.email]))
      );

      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && (request.auth.uid in request.resource.data.memberUids)
        && request.resource.data.memberUids.size() <= 2
        && request.resource.data.memberEmails.size() <= 6;

      allow update: if isSignedIn() && (
        // Existing member modifying settings or adding member email
        (request.auth.uid in resource.data.memberUids && request.resource.data.memberUids.size() <= 2)
        // User joining as the 2nd member
        || (
          resource.data.memberUids.size() == 1
          && (request.auth.uid in request.resource.data.memberUids)
          && request.resource.data.memberUids.size() == 2
          && (resource.data.memberUids[0] in request.resource.data.memberUids)
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.accountId == resource.data.accountId
        )
      );

      allow delete: if isSignedIn() && resource.data.createdBy == request.auth.uid;

      // Expenses subcollection
      match /expenses/{expenseId} {
        allow read: if isMemberOfAccount(accountId);
        allow create: if isMemberOfAccount(accountId)
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 200
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && (!('alreadySplit' in request.resource.data) || request.resource.data.alreadySplit is bool);
        allow update: if isMemberOfAccount(accountId)
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 200
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && (!('alreadySplit' in request.resource.data) || request.resource.data.alreadySplit is bool);
        allow delete: if isMemberOfAccount(accountId);
      }

      // Categories subcollection
      match /categories/{categoryId} {
        allow read: if isMemberOfAccount(accountId);
        allow create, update: if isMemberOfAccount(accountId)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 50;
        allow delete: if isMemberOfAccount(accountId);
      }

      // Payment Methods subcollection
      match /paymentMethods/{paymentMethodId} {
        allow read: if isMemberOfAccount(accountId);
        allow create, update: if isMemberOfAccount(accountId)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 50;
        allow delete: if isMemberOfAccount(accountId);
      }

      function getGoal(goalId) {
        return get(/databases/$(database)/documents/sharedAccounts/$(accountId)/goals/$(goalId)).data;
      }

      function isValidGoal(data) {
        return data.goalId is string && isValidId(data.goalId)
          && data.accountId == accountId
          && data.name is string && data.name.size() > 0 && data.name.size() <= 100
          && data.targetAmount is number && data.targetAmount > 0
          && data.savingsAccount is string && data.savingsAccount.size() > 0 && data.savingsAccount.size() <= 80
          && data.targetDate is string && data.targetDate.size() == 10 && data.targetDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
          && data.scope in ['shared', 'personal']
          && data.isHiddenFromPartner is bool
          && (data.scope == 'personal' || data.isHiddenFromPartner == false)
          && data.createdBy is string && data.createdBy.size() > 0 && data.createdBy.size() <= 128
          && data.createdByName is string && data.createdByName.size() > 0 && data.createdByName.size() <= 80;
      }

      function isValidGoalContribution(data, goalId, goalData) {
        return data.contributionId is string && isValidId(data.contributionId)
          && data.goalId == goalId
          && data.amount is number && data.amount > 0
          && data.date is string && data.date.size() == 10 && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
          && (!('note' in data) || (data.note is string && data.note.size() <= 150))
          && data.contributedBy is string && data.contributedBy.size() > 0 && data.contributedBy.size() <= 128
          && data.contributedByName is string && data.contributedByName.size() > 0 && data.contributedByName.size() <= 80
          && (goalData.scope == 'shared' || data.contributedBy == goalData.createdBy);
      }

      // Savings Goals subcollection
      match /goals/{goalId} {
        allow get: if isValidId(goalId)
          && isMemberOfAccount(accountId)
          && (resource.data.isHiddenFromPartner == false || resource.data.createdBy == request.auth.uid);

        allow list: if isMemberOfAccount(accountId)
          && (resource.data.isHiddenFromPartner == false || resource.data.createdBy == request.auth.uid);

        allow create: if isValidId(goalId)
          && isMemberOfAccount(accountId)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.keys().hasAll(['goalId', 'accountId', 'name', 'targetAmount', 'savingsAccount', 'targetDate', 'scope', 'isHiddenFromPartner', 'createdBy', 'createdByName'])
          && request.resource.data.keys().hasOnly(['goalId', 'accountId', 'name', 'targetAmount', 'savingsAccount', 'targetDate', 'scope', 'isHiddenFromPartner', 'createdBy', 'createdByName', 'createdAt', 'updatedAt'])
          && isValidGoal(request.resource.data);

        allow update: if isValidId(goalId)
          && isMemberOfAccount(accountId)
          && isValidGoal(request.resource.data)
          && request.resource.data.goalId == resource.data.goalId
          && request.resource.data.accountId == resource.data.accountId
          && request.resource.data.createdBy == resource.data.createdBy
          && (
            (resource.data.createdBy == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'targetAmount', 'savingsAccount', 'targetDate', 'scope', 'isHiddenFromPartner', 'updatedAt'])) ||
            (resource.data.scope == 'shared' && request.resource.data.scope == 'shared' && request.resource.data.isHiddenFromPartner == false && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'targetAmount', 'savingsAccount', 'targetDate', 'updatedAt']))
          );

        allow delete: if isValidId(goalId)
          && isMemberOfAccount(accountId)
          && (resource.data.scope == 'shared' || resource.data.createdBy == request.auth.uid);

        // Goal Contributions subcollection
        match /contributions/{contributionId} {
          allow read: if isValidId(goalId)
            && isMemberOfAccount(accountId)
            && (getGoal(goalId).isHiddenFromPartner == false || getGoal(goalId).createdBy == request.auth.uid);

          allow create: if isValidId(goalId)
            && isValidId(contributionId)
            && isMemberOfAccount(accountId)
            && (getGoal(goalId).scope == 'shared' || getGoal(goalId).createdBy == request.auth.uid)
            && request.resource.data.keys().hasAll(['contributionId', 'goalId', 'amount', 'date', 'contributedBy', 'contributedByName'])
            && request.resource.data.keys().hasOnly(['contributionId', 'goalId', 'amount', 'date', 'note', 'contributedBy', 'contributedByName', 'createdAt', 'updatedAt'])
            && isValidGoalContribution(request.resource.data, goalId, getGoal(goalId));

          allow update: if isValidId(goalId)
            && isValidId(contributionId)
            && isMemberOfAccount(accountId)
            && (getGoal(goalId).scope == 'shared' || getGoal(goalId).createdBy == request.auth.uid)
            && request.resource.data.contributionId == resource.data.contributionId
            && request.resource.data.goalId == resource.data.goalId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['amount', 'date', 'note', 'contributedBy', 'contributedByName', 'updatedAt'])
            && isValidGoalContribution(request.resource.data, goalId, getGoal(goalId));

          allow delete: if isValidId(goalId)
            && isValidId(contributionId)
            && isMemberOfAccount(accountId)
            && (getGoal(goalId).scope == 'shared' || getGoal(goalId).createdBy == request.auth.uid);
        }
      }
    }
  }
}
